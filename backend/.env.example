# Puerto del servidor
PORT=3000

# Base de datos PostgreSQL (desarrollo local)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=peluqueria_db
DB_USER=postgres
DB_PASSWORD=tu_password

# Base de datos PostgreSQL (Render - automático)
# DATABASE_URL se configurará automáticamente en Render

# JWT Secret (cambiar por uno seguro en producción)
JWT_SECRET=tu_clave_secreta_muy_segura_aqui

# Configuración de Email
EMAIL_USER=tu_email@gmail.com
EMAIL_PASSWORD=tu_password_de_aplicacion_gmail

# URL del Frontend (para CORS)
FRONTEND_URL=https://tu-frontend.onrender.com

# Entorno
NODE_ENV=production
