# Puerto del servidor
PORT=3000

# Base de datos PostgreSQL (desarrollo local)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=peluqueria_db
DB_USER=postgres
DB_PASSWORD=tu_password

# Base de datos PostgreSQL (Render - automático)
# DATABASE_URL se configurará automáticamente en Render

# JWT Secret (cambiar por uno seguro en producción)
JWT_SECRET=tu_clave_secreta_muy_segura_aqui

# Configuración de Email con Resend
EMAIL_USER=tu_email@gmail.com
RESEND_API_KEY=tu_resend_api_key_aqui

# URL del Frontend (para CORS)
FRONTEND_URL=https://wonderbarberia.onrender.com

# Cloudinary (para subir imágenes)
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# Entorno
NODE_ENV=production
